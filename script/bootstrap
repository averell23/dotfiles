#!/usr/bin/env bash
#
# bootstrap installs things. Safe to run on a fresh machine.

set -euo pipefail

DOTFILES="$(cd "$(dirname "$0")"/.. && pwd)"
cd "$DOTFILES"

GLOBAL_MODE=""

info()    { printf "  [ \033[00;34m..\033[0m ] %s\n" "$*"; }
success() { printf "  [ \033[00;32mOK\033[0m ] %s\n" "$*"; }
fail()    { printf "  [\033[0;31mFAIL\033[0m] %s\n" "$*" >&2; exit 1; }

install_nix() {
  if command -v nix > /dev/null 2>&1; then
    success "Nix already installed"
    return
  fi
  info "Installing Nix (Determinate Systems)..."
  curl --proto '=https' --tlsv1.2 -sSf -L https://install.determinate.systems/nix | sh -s -- install
  # Source nix into the current shell so subsequent steps can use it
  . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh 2>/dev/null || true
  success "Nix installed"
}

check_secrets() {
  local secret_file="system/secret_status.secret.txt"
  if [ -f "$secret_file" ] && [ "$(tr -d '[:space:]' < "$secret_file")" = "unlocked" ]; then
    success "Secrets unlocked"
  else
    fail "Secrets appear locked. Run: git-crypt unlock /path/to/your-key"
  fi
}

link_file() {
  local target="$1" link="$2" action=""

  if [ -L "$link" ] && [ "$(readlink "$link")" = "$target" ]; then
    success "Already linked: $link"
    return
  fi

  if [ -e "$link" ] || [ -L "$link" ]; then
    action="${GLOBAL_MODE:-}"
    if [ -z "$action" ]; then
      printf "  File exists: %s\n  [s]kip, [S]kip all, [o]verwrite, [O]verwrite all, [b]ackup, [B]ackup all? " "$link"
      read -r -n 1 action </dev/tty
      echo
    fi
    case "$action" in
      S) GLOBAL_MODE=s; action=s ;;
      O) GLOBAL_MODE=o; action=o ;;
      B) GLOBAL_MODE=b; action=b ;;
    esac
    case "$action" in
      s) success "Skipped $link"; return ;;
      o) rm -f "$link" ;;
      b) mv "$link" "${link}.backup"; success "Backed up to ${link}.backup" ;;
    esac
  fi

  ln -s "$target" "$link"
  success "Linked $target → $link"
}

create_symlinks() {
  while IFS= read -r dotfile; do
    dotfile="${dotfile#./}"
    local link="${dotfile#*/}"   # strip topic dir prefix
    link="${link//secret./}"     # strip secret.
    link="${link%.symlink}"      # strip .symlink suffix
    link=".$link"                # prepend dot
    mkdir -p "$HOME/$(dirname "$link")"
    link_file "$DOTFILES/$dotfile" "$HOME/$link"
  done < <(find . -name "*.symlink" | sort)
}

apply_darwin() {
  local hostname flake
  hostname="$(scutil --get LocalHostName)"
  flake="$DOTFILES/nix"

  if command -v darwin-rebuild > /dev/null 2>&1; then
    info "Applying nix-darwin for $hostname..."
    sudo darwin-rebuild switch --flake "$flake#$hostname"
  else
    info "Installing nix-darwin for $hostname (first run)..."
    (cd "$flake" && sudo nix run nix-darwin -- switch --flake ".#$hostname")
  fi
  success "nix-darwin applied"
}

install_nix
check_secrets
create_symlinks
apply_darwin
success "Bootstrap complete"
