{
  "extends": [
    "pi"
  ],
  "meta": {
    "name": "pi-claude",
    "version": "1.0.0",
    "description": "pi profile with Claude Code access, for use with the claude-bridge",
    "author": "Daniel Hahn"
  },
  "security": {
    "signal_mode": null,
    "process_info_mode": null,
    "ipc_mode": null,
    "capability_elevation": null,
    "approval_backends": {},
    "approval_defaults": null,
    "wsl2_proxy_policy": null
  },
  "groups": {
    "include": [
      "claude_code_macos"
    ],
    "exclude": []
  },
  "commands": {
    "allow": [],
    "deny": []
  },
  "filesystem": {
    "allow": [
      "~/.claude",
      "~/.claude.lock"
    ],
    "read": [],
    "write": [],
    "allow_file": [
      "~/.claude.json",
      "~/Library/Keychains/login.keychain-db",
      "/bin/ps"
    ],
    "read_file": [],
    "write_file": [],
    "unix_socket": [],
    "unix_socket_bind": [],
    "unix_socket_dir": [],
    "unix_socket_dir_bind": [],
    "unix_socket_subtree": [],
    "unix_socket_subtree_bind": [],
    "deny": [],
    "bypass_protection": [
      "~/Library/Keychains/login.keychain-db"
    ],
    "suppress_save_prompt": []
  },
  "network": {
    "block": false,
    "allow_http2": false,
    "allow_domain": [],
    "deny_domain": [],
    "open_port": [],
    "open_port_range": [],
    "listen_port": [],
    "listen_port_range": [],
    "connect_port": [],
    "no_proxy": [],
    "custom_credentials": {},
    "tls_intercept": null,
    "upstream_proxy": null,
    "upstream_bypass": [],
    "approval_backends": {},
    "approval_defaults": null
  },
  "diagnostics": {
    "suppress_system_services": [],
    "redaction": {
      "extra_env_vars": []
    },
    "network_denial_audit": {}
  },
  "linux": {
    "af_unix_mediation": null,
    "sandbox_policy": null
  },
  "env_credentials": {},
  "credential_capture": {},
  "credential_providers": {},
  "credential_routes": [],
  "workdir": {
    "access": "none"
  },
  "hooks": {},
  "session_hooks": {},
  "rollback": {
    "exclude_patterns": [],
    "exclude_globs": []
  },
  "skipdirs": [],
  "packs": [],
  "command_args": [],
  "unsafe_macos_seatbelt_rules": []
}
